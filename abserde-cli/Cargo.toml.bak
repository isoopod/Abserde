[package]
name = "abserde"
version = "0.2.1"
edition = "2024"

[dependencies]
anyhow = "1.0.104"
clap = { version = "4.5.54", features = ["derive"] }
full_moon = { version = "2.2.0", features = ["roblox"] }
inquire = "0.9.4"
keyring = "4.2.0"
open = "5.4.4"
openidconnect = "4.0.1"
reqwest = { version = "0.13.5", features = ["form", "json"] }
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.150"
tiny_http = "0.12.0"
tokio = { version = "1.53.1", features = ["full"] }
url = "2.5.8"
xxhash-rust = { version = "0.8.15", features = ["xxh3"] }
